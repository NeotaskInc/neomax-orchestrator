#!/usr/bin/env bash
set -euo pipefail

say() { printf '\033[1;36m[neomax-wt]\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m[neomax-wt] WARN\033[0m %s\n' "$1"; }

resolved="$(python3 - "$PWD" <<'PY'
import json, os, re, sys
cwd = os.path.realpath(os.path.abspath(sys.argv[1]))
state = os.environ.get("NEOMAX_HOME") or os.path.expanduser("~/.neomax")
try:
    projects = json.load(open(os.path.join(state, "projects.json")))
except Exception:
    projects = {}
best = None
for name, cfg in projects.items():
    root = os.path.realpath(os.path.abspath(os.path.expanduser(str(cfg.get("root") or ""))))
    if root and (cwd == root or cwd.startswith(root + os.sep)):
        if best is None or len(root) > len(best[1]):
            best = (name, root, cfg)
if best:
    name, root, cfg = best
    repos = cfg.get("repos") or ["."]
    prefix = cfg.get("branch_prefix") or re.sub(r"[^a-z0-9]", "", name.lower())[:4] or "proj"
else:
    try:
        import subprocess
        run = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5)
        root = run.stdout.strip() if run.returncode == 0 else cwd
    except Exception:
        root = cwd
    name = re.sub(r"[^a-z0-9]", "", os.path.basename(root).lower()) or "project"
    prefix = name[:4]
    if os.path.exists(os.path.join(root, ".git")):
        repos = ["."]
    else:
        try:
            repos = [x for x in sorted(os.listdir(root))
                     if os.path.exists(os.path.join(root, x, ".git"))]
        except OSError:
            repos = []
        repos = repos or ["."]
print("\t".join((root, " ".join(repos), prefix, name)))
PY
)"
IFS=$'\t' read -r detected_root detected_repos detected_prefix detected_name <<< "$resolved"
PROJECT_DIR="${NEOMAX_PROJECT_DIR:-$detected_root}"
repo_words="${NEOMAX_REPOS:-$detected_repos}"
read -r -a REPOS <<< "$repo_words"
BRANCH_PREFIX="${NEOMAX_BRANCH_PREFIX:-$detected_prefix}"
STATE_ROOT="${NEOMAX_HOME:-$HOME/.neomax}"
WT_ROOT="${NEOMAX_WORKTREE_ROOT:-$STATE_ROOT/coordinated-worktrees/$detected_name}"

if [ "${1:-}" = "--list" ]; then
  [ -d "$WT_ROOT" ] || { echo "no worktree sets"; exit 0; }
  for dir in "$WT_ROOT"/*/; do
    [ -d "$dir" ] || continue
    printf '%s\n' "$(basename "$dir")"
    for repo in "${REPOS[@]}"; do
      label="${repo//\//-}"; [ "$repo" = "." ] && label="$(basename "$PROJECT_DIR")"
      [ -d "$dir$label" ] && printf '    %-20s %s\n' "$repo" "$(git -C "$dir$label" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    done
  done
  exit 0
fi

if [ "${1:-}" = "--remove" ]; then
  task="${2:?usage: neomax-worktrees --remove <task-slug>}"
  set_dir="$WT_ROOT/$task"
  [ -d "$set_dir" ] || { warn "no set $task"; exit 1; }
  for repo in "${REPOS[@]}"; do
    main_repo="$PROJECT_DIR/$repo"; [ "$repo" = "." ] && main_repo="$PROJECT_DIR"
    label="${repo//\//-}"; [ "$repo" = "." ] && label="$(basename "$PROJECT_DIR")"
    wt="$set_dir/$label"
    [ -d "$wt" ] || continue
    [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || { warn "$repo has uncommitted changes; refusing"; exit 2; }
    git -C "$main_repo" worktree remove "$wt"
  done
  rmdir "$set_dir" 2>/dev/null || true
  say "removed $task"
  exit 0
fi

task="${1:?usage: neomax-worktrees <task-slug> [branch] [--base REF]}"
branch="${2:-$BRANCH_PREFIX/$task}"
base_ref=""
[ "${2:-}" = "--base" ] && { branch="$BRANCH_PREFIX/$task"; base_ref="${3:-}"; }
[ "${3:-}" = "--base" ] && base_ref="${4:-}"
set_dir="$WT_ROOT/$task"
mkdir -p "$set_dir"
say "creating '$task' on '$branch' across: ${REPOS[*]}"
for repo in "${REPOS[@]}"; do
  main_repo="$PROJECT_DIR/$repo"; [ "$repo" = "." ] && main_repo="$PROJECT_DIR"
  [ -e "$main_repo/.git" ] || { warn "skip $repo (not a git repository at $main_repo)"; continue; }
  label="${repo//\//-}"; [ "$repo" = "." ] && label="$(basename "$PROJECT_DIR")"
  wt="$set_dir/$label"
  [ -d "$wt" ] && { say "$repo already present at $wt"; continue; }
  base="${base_ref:-$(git -C "$main_repo" symbolic-ref --short HEAD 2>/dev/null || echo main)}"
  if git -C "$main_repo" rev-parse --verify "$branch" >/dev/null 2>&1; then
    git -C "$main_repo" worktree add "$wt" "$branch" >/dev/null
  else
    git -C "$main_repo" worktree add -b "$branch" "$wt" "$base" >/dev/null
  fi
  say "$repo -> $wt"
done

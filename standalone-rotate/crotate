def cmd_portal(argv):
    """crotate portal [--port 8787] [--no-open] — read-only localhost dashboard."""
    import http.server
    port = 8787
    if "--port" in argv:
        try:
            port = int(argv[argv.index("--port") + 1])
        except (ValueError, IndexError):
            pass
    auto_open = "--no-open" not in argv and not os.environ.get("CROTATE_NO_OPEN")

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.split("?")[0] == "/status.json":
                try:
                    body = json.dumps(gather_status()).encode()
                except Exception as e:
                    body = json.dumps({"error": str(e)}).encode()
                ct = "application/json"
            else:
                body = PORTAL_HTML.encode()
                ct = "text/html; charset=utf-8"
            self.send_response(200)
            self.send_header("Content-Type", ct)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    url = "http://127.0.0.1:%d" % port
    print("crotate portal → %s  (read-only; Ctrl-C to stop)" % url)
    if auto_open:
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            pass  # headless / no browser — the URL is printed either way
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


# ---------- main ----------

def usage():
    print(__doc__.split("Commands:", 1)[0].rstrip())
    print("Commands:" + __doc__.split("Commands:", 1)[1])


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return
    cmd, rest = argv[0], argv[1:]
    if cmd in ("session-rotate", "session_rotate", "rotate"):
        cmd_session_rotate(rest)
    elif cmd == "disarm":
        cmd_disarm(rest)
    elif cmd == "usage-hook":
        cmd_usage_hook(rest)
    elif cmd in ("tick", "rotate-tick"):
        cmd_tick(rest)
    elif cmd == "rotate-auth":
        cmd_rotate_auth(rest)
    elif cmd == "login":
        cmd_login(rest)
    elif cmd == "run":
        cmd_run(rest)
    elif cmd == "status":
        cmd_status(rest)
    elif cmd == "log":
        cmd_rotate_auth(["--log"])
    elif cmd == "pause":
        cmd_pause(rest, True)
    elif cmd == "unpause":
        cmd_pause(rest, False)
    elif cmd == "portal":
        cmd_portal(rest)
    else:
        err("crotate: unknown command %r (crotate --help)" % cmd)
        sys.exit(2)


if __name__ == "__main__":
    main()

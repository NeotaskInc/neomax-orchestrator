#!/bin/zsh
set -u

GROK_BIN="${NEOMAX_GROK_BIN:-grok}"
GROK_MODEL="${NEOMAX_GROK_MODEL:-grok-4.6}"
CLAUDE_WORKER_MODEL="${NEOMAX_CLAUDE_MODEL:-claude-fable-5[1m]}"
CODEX_WORKER_MODEL="${NEOMAX_CODEX_MODEL:-gpt-5.6-sol}"
OPENCODE_WORKER_MODEL="${NEOMAX_OPENCODE_MODEL:-opencode-go/ox-alpha-free}"
KIMI_WORKER_MODEL="${NEOMAX_KIMI_MODEL:-kimi-code/k3}"
SELF_DIR="${0:A:h}"
DEFAULT_PROFILE="$HOME/.grok"
PROFILES=("$DEFAULT_PROFILE" $HOME/.grok-acct<2->(Nn/))
if [[ -x "$SELF_DIR/neomax" ]]; then NEOMAX_BIN="$SELF_DIR/neomax"; else NEOMAX_BIN="neomax"; fi

profile_for() { if (( $1 == 1 )); then print "$DEFAULT_PROFILE"; else print "$HOME/.grok-acct$1"; fi }
acct_num() {
  if [[ "$1" == "$DEFAULT_PROFILE" ]]; then print 1
  elif [[ "$1" == *-orch ]]; then print orch
  else print "${1##*-acct}"
  fi
}
set_profile_env() {
  if [[ "$1" == "$DEFAULT_PROFILE" ]]; then unset GROK_HOME
  else mkdir -p "$1"; export GROK_HOME="$1"
  fi
}
logged_in() {
  python3 - "$1/auth.json" <<'PY' >/dev/null 2>&1
import json,sys
try: d=json.load(open(sys.argv[1])) or {}
except Exception: raise SystemExit(1)
raise SystemExit(0 if any(isinstance(v,dict) and v.get("key") for v in d.values()) else 1)
PY
}
count_live() {
  python3 - "$1" <<'PY' 2>/dev/null || print 0
import glob,json,os,sys
n=0
for p in glob.glob(os.path.expanduser("~/.neomax/runs/*.json")):
    try:
        r=json.load(open(p))
        if r.get("engine")=="grok" and r.get("profile")==sys.argv[1] and r.get("status")=="running":
            os.kill(int(r.get("worker_pid")),0); n+=1
    except Exception: pass
print(n)
PY
}
launch_portal() {
  portal="${NEOMAX_PORTAL_BIN:-}"
  if [[ -z "$portal" && -x "$SELF_DIR/neomax-portal" ]]; then portal="$SELF_DIR/neomax-portal"
  elif [[ -z "$portal" ]] && command -v neomax-portal >/dev/null 2>&1; then portal="neomax-portal"
  fi
  [[ -n "$portal" ]] || { print "gmax: neomax-portal not found" >&2; return 1; }
  exec "$portal" "$@"
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  print -r -- 'usage: gmax [ACCOUNT] [--workers SCOPE] [--model MODEL] [INITIAL_TASK...]
       gmax --orchestrator [--workers SCOPE] [--model MODEL] [INITIAL_TASK...]
       gmax resume [SESSION_ID] [--workers SCOPE] [--model MODEL]
       gmax status
       gmax portal [PORT]

SCOPE is all, one engine, or a comma/plus list of claude,codex,opencode,kimi,grok.
grok-4.6 is the default model; --model/--grok-model selects another Grok CLI model.
Other --ENGINE-model flags set that delegated worker engine’s model.'
  exit 0
fi
if [[ "${1:-}" == "portal" ]]; then shift; launch_portal "$@"; fi
if [[ "${1:-}" == "status" ]]; then exec "$NEOMAX_BIN" status; fi

fleet="grok"; want_orch=0; newargs=()
while (( $# )); do
  case "$1" in
    --workers) fleet="${2:-grok}"; shift 2;;
    --workers=*) fleet="${1#--workers=}"; shift;;
    --orchestrator) want_orch=1; shift;;
    --model|--grok-model) GROK_MODEL="$2"; shift 2;;
    --model=*|--grok-model=*) GROK_MODEL="${1#*=}"; shift;;
    --claude-model) CLAUDE_WORKER_MODEL="$2"; shift 2;;
    --claude-model=*) CLAUDE_WORKER_MODEL="${1#*=}"; shift;;
    --codex-model) CODEX_WORKER_MODEL="$2"; shift 2;;
    --codex-model=*) CODEX_WORKER_MODEL="${1#*=}"; shift;;
    --opencode-model) OPENCODE_WORKER_MODEL="$2"; shift 2;;
    --opencode-model=*) OPENCODE_WORKER_MODEL="${1#*=}"; shift;;
    --kimi-model) KIMI_WORKER_MODEL="$2"; shift 2;;
    --kimi-model=*) KIMI_WORKER_MODEL="${1#*=}"; shift;;
    *) newargs+=("$1"); shift;;
  esac
done
set -- "${newargs[@]}"
python3 - "$fleet" <<'PY' || { print "gmax: --workers must be all or a comma/plus list of claude,codex,opencode,kimi,grok" >&2; exit 2; }
import re,sys
p={x for x in re.split(r"[,+]",sys.argv[1]) if x}
raise SystemExit(0 if sys.argv[1]=="all" or (p and p<={"claude","codex","opencode","kimi","grok"}) else 1)
PY
export NEOMAX_FLEET="$fleet" NEOMAX_ROLE="grok" NEOMAX_PROJECT_ROOT="$PWD"
export NEOMAX_CLAUDE_MODEL="$CLAUDE_WORKER_MODEL" NEOMAX_CODEX_MODEL="$CODEX_WORKER_MODEL"
export NEOMAX_OPENCODE_MODEL="$OPENCODE_WORKER_MODEL" NEOMAX_KIMI_MODEL="$KIMI_WORKER_MODEL"
export NEOMAX_GROK_MODEL="$GROK_MODEL"
export NEOMAX_ORCH_SESSION="orch-grok-$$-$(date +%s)" NEOMAX_ORCH_PID=$$
register_orch() { "$NEOMAX_BIN" orch-register 2>/dev/null || true; }

if [[ "${1:-}" == "resume" || "${1:-}" == "--resume" ]]; then
  shift; wanted="${1:-}"
  loc=$(python3 - "$wanted" <<'PY'
import glob,json,os,sys
wanted=sys.argv[1]; home=os.path.expanduser("~")
profiles=[os.path.join(home,".grok")]+sorted(glob.glob(os.path.join(home,".grok-acct*")))
orch=os.path.join(home,".grok-orch")
if os.path.isdir(orch): profiles.append(orch)
best=None
for profile in profiles:
    for path in glob.glob(os.path.join(profile,"sessions","**","summary.json"),recursive=True):
        try: d=json.load(open(path)) or {}; info=d.get("info") or {}; sid=info.get("id") or ""; stamp=os.path.getmtime(path)
        except Exception: continue
        if wanted and (sid==wanted or (len(wanted)>=8 and sid.startswith(wanted))):
            print(profile+"\t"+sid+"\t"+(info.get("cwd") or os.getcwd())); raise SystemExit(0)
        if not wanted and (best is None or stamp>best[0]): best=(stamp,profile,sid,info.get("cwd") or os.getcwd())
if best: print(best[1]+"\t"+best[2]+"\t"+best[3]); raise SystemExit(0)
raise SystemExit(1)
PY
  ) || { print "gmax: session ${wanted:-<most recent>} not found"; exit 1; }
  prof="${loc%%$'\t'*}"; rest="${loc#*$'\t'}"; sid="${rest%%$'\t'*}"; cwd="${rest#*$'\t'}"
  set_profile_env "$prof"; cd "$cwd" || exit 1
  print "gmax → resuming Grok session $sid on account $(acct_num "$prof") · workers=$fleet"
  if [[ -n "${NEOMAX_DRY_RUN:-}" ]]; then print "DRY: grok --resume $sid --model $GROK_MODEL --always-approve"; exit 0; fi
  register_orch
  exec "$GROK_BIN" --no-auto-update --resume "$sid" --model "$GROK_MODEL" --always-approve --cwd "$cwd"
fi

if (( want_orch )); then
  pick="$HOME/.grok-orch"; export NEOMAX_ORCH_RESERVED=1
  logged_in "$pick" || { print "gmax: no dedicated Grok orchestrator account — run: gmx login orch"; exit 1; }
elif [[ "${1:-}" == <1-> ]]; then
  n="$1"; shift; pick="$(profile_for "$n")"
else
  pick="$("$NEOMAX_BIN" pick-orch --engine grok 2>/dev/null)"
  if [[ -z "$pick" ]]; then
    best=999999
    for prof in "${PROFILES[@]}"; do
      logged_in "$prof" || continue; live="$(count_live "$prof")"
      if (( live < best )); then pick="$prof"; best=$live; fi
    done
  fi
  [[ -n "$pick" ]] || pick="$DEFAULT_PROFILE"
fi
logged_in "$pick" || { print "gmax: Grok account $(acct_num "$pick") is not connected — run: gmx login $(acct_num "$pick")"; exit 1; }
set_profile_env "$pick"
print "gmax → Grok Build orchestrator on account $(acct_num "$pick") ($pick) · model=$GROK_MODEL · workers=$fleet"
opener="$("$NEOMAX_BIN" orient 2>/dev/null)"
if (( $# )); then opener+=$'\n\nUSER\047S INITIAL TASK:\n'"$*"; fi
if [[ -n "${NEOMAX_DRY_RUN:-}" ]]; then print "DRY: grok --model $GROK_MODEL --always-approve <orchestrator-opener>"; exit 0; fi
register_orch
exec "$GROK_BIN" --no-auto-update --model "$GROK_MODEL" --always-approve --cwd "$PWD" "$opener"

var _PIERRE=null;
function nativeDiffHtml(patch){
  return (patch||'').split('\n').map(function(l){
    var e=esc(l),st='';
    if(l.indexOf('+++')===0||l.indexOf('---')===0)st='font-weight:700';
    else if(l.indexOf('@@')===0)st='color:var(--dim);background:var(--card2)';
    else if(l.charAt(0)==='+')st='color:#2e7d32;background:rgba(46,125,50,.08)';
    else if(l.charAt(0)==='-')st='color:var(--accent);background:rgba(255,92,0,.07)';
    else if(l.indexOf('diff --git')===0)st='font-weight:700;border-top:1px solid var(--line);display:block;margin-top:8px;padding-top:8px';
    return '<span style="display:block;'+st+'">'+(e||' ')+'</span>';
  }).join('');
}
function viewDiff(id){
  document.getElementById('logTitle').textContent='diff · '+id;
  var el=document.getElementById('logBody');
  el.textContent='loading diff…';
  document.getElementById('logModal').classList.add('show');
  fetch('/api/rundiff/'+id).then(function(r){return r.json()}).then(function(j){
    if(j.error){el.textContent=j.error;return}
    var head='<div style="margin-bottom:8px"><b>'+esc(j.branch||'')+'</b> <span class=muted>vs '+esc(j.base||'')+' · '+esc(j.repo||'')+'</span> · <span style="color:var(--ok)">+'+(j.adds||0)+'</span> <span style="color:var(--accent)">−'+(j.dels||0)+'</span></div>'+
      '<table style="margin-bottom:10px"><tr><th>file</th><th style="text-align:right">+</th><th style="text-align:right">−</th></tr>'+
      (j.files||[]).map(function(f){return '<tr><td class=mono style="font-size:11px">'+esc(f.path)+'</td><td style="text-align:right;color:var(--ok)">+'+f.adds+'</td><td style="text-align:right;color:var(--accent)">−'+f.dels+'</td></tr>'}).join('')+'</table>';
    el.innerHTML=head+'<div id=diffBody style="font:11px/1.5 ui-monospace,monospace;white-space:pre-wrap">'+nativeDiffHtml(j.patch)+'</div>';
    if(j.patch)renderPierreDiff(j.patch);
  }).catch(function(){el.textContent='(failed to load diff)'});
}
function renderPierreDiff(patch){
  // diffs.com (@pierre/diffs) — upgrade the native rendering in place when the
  // library loads + renders; otherwise the native view stays. Best-effort.
  (async function(){
    try{
      var mod=_PIERRE||(await import('https://esm.sh/@pierre/diffs@1.2.10'));_PIERRE=mod;
      var host=document.getElementById('diffBody');if(!host)return;
      var files=mod.parsePatchFiles?mod.parsePatchFiles(patch):null;
      if(files&&files.length&&mod.FileDiff){
        var wrap=document.createElement('div');
        for(var i=0;i<files.length;i++){
          var fd=new mod.FileDiff({theme:{dark:'github-dark',light:'github-light'}});
          var node=document.createElement('div');wrap.appendChild(node);
          await fd.render({fileDiff:files[i],element:node});
        }
        host.innerHTML='';host.appendChild(wrap);
      }
    }catch(e){/* native fallback stays */}
  })();
}
function viewLog(id){
  document.getElementById('logTitle').textContent='log · '+id;
  document.getElementById('logBody').textContent='loading…';
  document.getElementById('logModal').classList.add('show');
  fetch('/api/log/'+id).then(function(r){return r.text()}).then(function(t){
    var el=document.getElementById('logBody');el.textContent=t||'(empty)';el.scrollTop=el.scrollHeight;
  }).catch(function(){document.getElementById('logBody').textContent='(failed to load log)'});
}
var PROJFILTER='';
function buildProjFilter(s){
  var set={};
  (s.runs||[]).forEach(function(r){if(r.project)set[r.project]=1});
  (s.ambient||[]).forEach(function(r){if(r.project)set[r.project]=1});
  var names=Object.keys(set).sort();
  var el=document.getElementById('projFilter');if(!el)return;
  if(names.length<2){el.innerHTML='';return}   // only show the filter when 2+ projects appear
  el.innerHTML='<span class=muted style="font-size:10px;text-transform:uppercase;letter-spacing:.1em">project</span>'+
    ['', ].concat(names).map(function(n){
      return '<span class="tab'+(PROJFILTER===n?' active':'')+'" data-proj-filter="'+esc(n)+'" style="padding:3px 9px;font-size:10px">'+(n?esc(n):'all')+'</span>';
    }).join('');
  applyProjFilter();
}
function applyProjFilter(){
  document.querySelectorAll('#runs tr[data-proj],#history tr[data-proj]').forEach(function(tr){
    tr.style.display=(!PROJFILTER||tr.getAttribute('data-proj')===PROJFILTER)?'':'none';
  });
}
var MODES=null;
function cmdBlock(c){return '<code class=cmd data-copy="'+esc(c)+'" title="click to copy">'+esc(c)+'</code>'}
function renderModes(){
  var box=document.getElementById('modesBody');
  if(!MODES){box.innerHTML='<div class=muted>loading…</div>';return}
  if(!(MODES.modes||[]).length&&!(MODES.account_commands||[]).length){
    box.innerHTML='<div class=muted>no modes available — is neomax up to date? (`neomax modes --json`)</div>';return}
  var h='';
  if(MODES.launch_dir)h+='<div class=tch style="margin:0 0 4px">run from: <span class=mono>'+esc(MODES.launch_dir)+'</span></div>';
  function modeRow(m){
    var ow=(m.orchestrator||m.workers)?' <span class=eng>'+esc(m.orchestrator||'')+' → '+esc(m.workers||'')+'</span>':'';
    return '<div class=moderow><div class=mtitle>'+esc(m.title||m.id||'')+ow+'</div>'+
      '<div style="margin:6px 0 4px">'+cmdBlock(m.cmd||'')+'</div>'+
      (m.why?'<div class=tch>'+esc(m.why)+'</div>':'')+'</div>';
  }
  // group modes by their (optional) section, preserving first-appearance order
  var secOrder=[],bySec={};
  (MODES.modes||[]).forEach(function(m){
    var s=m.section||'Start an orchestrator session';
    if(!bySec[s]){bySec[s]=[];secOrder.push(s)}
    bySec[s].push(m);
  });
  secOrder.forEach(function(s){
    h+='<div class=modesec>'+esc(s)+'</div>';
    h+=bySec[s].map(modeRow).join('');
  });
  h+='<div class=modesec>Accounts &amp; tools</div>';
  h+=(MODES.account_commands||[]).map(function(c){
    return '<div class=moderow><div class=mtitle>'+esc(c.what||'')+'</div><div style="margin-top:6px">'+cmdBlock(c.cmd||'')+'</div></div>';
  }).join('');
  box.innerHTML=h;
}
function openModes(){
  document.getElementById('modesModal').classList.add('show');
  renderModes();
  fetch('/api/modes').then(function(r){return r.json()}).then(function(j){MODES=j;renderModes()})
    .catch(function(){if(!MODES){MODES={};renderModes()}});
}
function copyCmd(el){
  var c=el.getAttribute('data-copy')||'';
  function flash(){el.textContent='copied';setTimeout(function(){el.textContent=c},900)}
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(c).then(flash,function(){legacyCopy(c);flash()})}
  else{legacyCopy(c);flash()}
}
function legacyCopy(s){
  var ta=document.createElement('textarea');ta.value=s;ta.style.position='fixed';ta.style.opacity='0';
  document.body.appendChild(ta);ta.select();
  try{document.execCommand('copy')}catch(e){}
  document.body.removeChild(ta);
}

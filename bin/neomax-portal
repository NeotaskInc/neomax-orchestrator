class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        try:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            # The browser closed the socket before we finished writing — a poll
            # superseded by the 5s refresh, a closed tab, a navigated-away page.
            # Entirely normal; swallow it so ThreadingHTTPServer doesn't dump a
            # traceback per disconnect. Mark the conn closed so the thread exits.
            self.close_connection = True

    def log_message(self, *a):
        pass  # quiet

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/" or path == "/index.html":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/api/status":
            self._send(200, json.dumps(status_json()))
        elif path == "/api/history":
            self._send(200, json.dumps(history_json()))
        elif path == "/api/modes":
            self._send(200, json.dumps(modes_json()))
        elif path == "/api/usage":
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            try:
                days = int((q.get("days") or ["30"])[0])
            except ValueError:
                days = 30
            self._send(200, json.dumps(usage_json(days)))
        elif path == "/api/sessions":
            self._send(200, json.dumps(sessions_json()))
        elif path == "/api/subagents":
            self._send(200, json.dumps(subagents_json()))
        elif path.startswith("/api/rundiff/"):
            rid = path[len("/api/rundiff/"):]
            if not re.match(r"^\d{8}-\d{6}-\d+(-[A-Za-z0-9._-]+)?$", rid):
                self._send(400, json.dumps({"error": "invalid run id"}))
            else:
                self._send(200, json.dumps(rundiff_json(rid)))
        elif path == "/api/prstate":
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            url = (q.get("url") or [""])[0]
            self._send(200, json.dumps(pr_state(url)))
        elif path.startswith("/api/log/"):
            rid = path[len("/api/log/"):]
            if not re.match(r"^\d{8}-\d{6}-\d+(-[A-Za-z0-9._-]+)?$", rid):
                self._send(400, "invalid run id", "text/plain; charset=utf-8")
            else:
                self._send(200, run_log(rid) or "(no log available)",
                           "text/plain; charset=utf-8")
        else:
            self._send(404, "{}")

    def _same_origin(self):
        # reject cross-origin POSTs (defense-in-depth vs a malicious page in the
        # browser POSTing to 127.0.0.1). A same-origin fetch sends no Origin or our
        # own; browsers cannot forge Origin.
        origin = self.headers.get("Origin")
        if origin and origin not in ("http://127.0.0.1:%d" % PORT,
                                     "http://localhost:%d" % PORT):
            return False
        return True

    def do_POST(self):
        if not self._same_origin():
            self._send(403, json.dumps({"error": "cross-origin POST rejected"}))
            return
        parts = urllib.parse.urlparse(self.path).path.strip("/").split("/")
        try:
            if parts[:2] == ["api", "connect"] and len(parts) == 4:
                self._send(200, json.dumps(self._connect(parts[2], parts[3])))
            elif parts[:2] == ["api", "act"] and len(parts) == 4:
                self._send(200, json.dumps(self._act(parts[2], parts[3])))
            elif parts[:2] == ["api", "pause"] and len(parts) == 4:
                self._send(200, json.dumps(self._pause(parts[2], parts[3], True)))
            elif parts[:2] == ["api", "unpause"] and len(parts) == 4:
                self._send(200, json.dumps(self._pause(parts[2], parts[3], False)))
            else:
                self._send(404, "{}")
        except Exception as e:
            self._send(500, json.dumps({"error": str(e)}))

    def _connect(self, eng, n):
        if eng not in ("claude", "codex", "opencode", "kimi", "grok") or not (n.isdigit() or n == "orch"):
            return {"error": "bad engine/account"}          # digits or 'orch' only → no injection
        if eng == "codex":
            prof = os.path.join(HOME, ".codex-orch" if n == "orch"
                                else (".codex" if n == "1" else ".codex-acct%s" % n))
            os.makedirs(prof, exist_ok=True)
            env = dict(os.environ, CODEX_HOME=prof)
            subprocess.Popen(["codex", "login"], env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return {"message": "codex login started for account %s — complete the "
                    "browser sign-in, then it will show as authenticated." % n}
        if eng == "opencode":
            arg = "orch" if n == "orch" else n
            if sys.platform == "darwin":
                subprocess.Popen(["osascript", "-e",
                    'tell app "Terminal" to do script "ocx login %s"' % arg],
                    start_new_session=True)
                return {"message": "opened a Terminal running `ocx login %s`." % arg}
            return {"message": "run `ocx login %s` in a terminal." % arg}
        if eng == "kimi":
            arg = "orch" if n == "orch" else n
            if sys.platform == "darwin":
                subprocess.Popen(["osascript", "-e",
                    'tell app "Terminal" to do script "kmx login %s choose"' % arg],
                    start_new_session=True)
                return {"message": "opened a Terminal running `kmx login %s choose`." % arg}
            return {"message": "run `kmx login %s choose` in a terminal." % arg}
        if eng == "grok":
            arg = "orch" if n == "orch" else n
            if sys.platform == "darwin":
                subprocess.Popen(["osascript", "-e",
                    'tell app "Terminal" to do script "gmx login %s choose"' % arg],
                    start_new_session=True)
                return {"message": "opened a Terminal running `gmx login %s choose`." % arg}
            return {"message": "run `gmx login %s choose` in a terminal." % arg}
        if sys.platform == "darwin":
            # n is validated digits-only above, so it cannot break out of the string.
            arg = "orchestrator" if n == "orch" else n
            subprocess.Popen(["osascript", "-e",
                'tell app "Terminal" to do script "cmax %s"' % arg], start_new_session=True)
            return {"message": "opened a Terminal running `cmax %s` — run /login "
                    "there to sign in." % arg}
        return {"message": "run `cmax %s` in a terminal, then /login." % (
            "orchestrator" if n == "orch" else n)}

    def _pause(self, eng, n, on):
        # toggle an account in/out of auto-dispatch. n is validated digits/'orch' (no injection).
        if eng not in ("claude", "codex", "opencode", "kimi", "grok") or not (n.isdigit() or n == "orch"):
            return {"error": "bad engine/account"}
        cmd = "pause" if on else "unpause"
        try:
            r = subprocess.run([NEOMAX, cmd, n, "--engine", eng],
                               capture_output=True, text=True, timeout=15)
            return {"message": (r.stdout or r.stderr).strip()[:200]
                    or ("%sd %s account %s" % (cmd, eng, n))}
        except (OSError, subprocess.TimeoutExpired) as e:
            return {"error": str(e)}

    def _act(self, action, rid):
        if action not in ("resume", "retry", "kill", "ack", "clean"):
            return {"error": "unknown action"}
        # rid MUST be a real run-id: base (YYYYMMDD-HHMMSS-PID) or a run-all part
        # (base + "-<partid>"). Never a flag like "--done"/"--all", so a CSRF/forged
        # request can't trigger a bulk op (the leading digits forbid a "-" prefix).
        if not re.match(r"^\d{8}-\d{6}-\d+(-[A-Za-z0-9._-]+)?$", rid):
            return {"error": "invalid run id"}
        if action in ("resume", "retry"):
            # these BLOCK for the whole worker run — detach so the HTTP request
            # returns immediately and the run isn't killed when the portal stops.
            # Honor NEOMAX_HOME (hermetic tests / relocated state) instead of hardcoding
            # ~/.neomax, and close the parent's log fd after spawn so it isn't leaked.
            state = os.environ.get("NEOMAX_HOME") or os.path.expanduser("~/.neomax")
            try:
                os.makedirs(state, exist_ok=True)
                logf = open(os.path.join(state, "portal-%s.log" % rid), "ab")
            except OSError:
                logf = subprocess.DEVNULL
            try:
                subprocess.Popen([NEOMAX, action, rid], stdout=logf, stderr=logf,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
            finally:
                if logf is not subprocess.DEVNULL:
                    try:
                        logf.close()
                    except OSError:
                        pass
            return {"message": "%s started for %s — watch the run ledger." % (action, rid)}
        r = subprocess.run([NEOMAX, action, rid], capture_output=True,
                           text=True, timeout=30)
        return {"message": (r.stdout or r.stderr).strip()[:300]}


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def ensure_usage_watcher():
    """Belt-and-suspenders: the token-usage watcher normally runs as a launchd agent
    (auto), but if it isn't running, start a detached one so the dashboard always has
    live usage. Never fails the portal."""
    try:
        r = subprocess.run(["pgrep", "-f", "neomax usage-watch"],
                           capture_output=True, text=True, timeout=5)
        if not r.stdout.strip():
            subprocess.Popen([sys.executable, NEOMAX, "usage-watch"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
    except Exception:
        pass


if __name__ == "__main__":
    ensure_usage_watcher()
    httpd = Server(("127.0.0.1", PORT), Handler)
    print("neomax-portal → http://127.0.0.1:%d  (Ctrl-C to stop)" % PORT)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")

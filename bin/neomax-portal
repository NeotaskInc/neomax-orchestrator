      '<div class=tch>'+fmtTok(t.completions||0)+'/'+fmtTok(t.requests||0)+' completed/requests · '+fmtTok(t.errors||0)+' failures · '+fmtTok(t.rate_limits||0)+' rate limits · '+fmtTok(t.sessions||0)+' sessions ('+fmtTok(t.native_subagents||0)+' native subagents) · '+fmtTok(t.tool_calls||0)+' tools · '+fmtTok(t.files||0)+' files</div>'+
      '<div class=modesec>Models</div>'+usageTable('model',p.models||[],function(r){return esc(r.model||'?')})+'</div>';

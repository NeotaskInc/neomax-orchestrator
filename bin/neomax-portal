<script>
var DATA=null;
function esc(s){return (s||'').replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function nowS(){return Math.floor(Date.now()/1000)}
function fmtAge(sec){sec=Math.max(0,sec|0);if(sec<60)return sec+'s';var m=(sec/60)|0;if(m<60)return m+'m '+(sec%60)+'s';var h=(m/60)|0;if(h<24)return h+'h '+(m%60)+'m';return ((h/24)|0)+'d '+(h%24)+'h'}
function clockTime(t){var d=new Date(t*1000);return d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}
// reset label: time only if it's today, else weekday + month/day + time (so a 7-day
// window — days out — shows the date, not just a time).
function resetLabel(t){var d=new Date(t*1000),n=new Date();
  if(d.toDateString()===n.toDateString())return clockTime(t);
  return d.toLocaleString([],{weekday:'short',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}
function barCls(p){return p>=85?'hi':(p>=60?'mid':'')}
function projBadge(p){if(!p)return '';var cs=['var(--accent)','#7b5aff','#12a594','#d18b00'],h=0;for(var i=0;i<p.length;i++)h=(h*31+p.charCodeAt(i))>>>0;var c=cs[h%cs.length];return '<span class=chip style="border-color:'+c+';color:'+c+'" title="project: '+esc(p)+'">'+esc(p)+'</span>'}
function fmtTok(n){n=n||0;if(n>=1e9)return +(n/1e9).toFixed(2)+'B';if(n>=1e6)return +(n/1e6).toFixed(1)+'M';if(n>=1000)return +(n/1000).toFixed(1)+'k';return String(n)}
// input / output / cache breakdown (cache shown only when present). "—" if nothing yet.
function fmtTokParts(t){t=t||{};var p=[];if(t.in)p.push(fmtTok(t.in)+' in');if(t.out)p.push(fmtTok(t.out)+' out');if(t.cache)p.push(fmtTok(t.cache)+' cache');return p.join(' · ')||'—'}
function fmtTokBreak(t,title){t=t||{};if(!(t.in||t.out||t.cache))return '';return ' · <span class=eng title="'+(title||'')+'">'+fmtTokParts(t)+'</span>'}
function fmtUsd(v){return '$'+(v||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}
function shortModel(m){return m?String(m).replace(/^claude-/,''):''}
function usage(a,eng){
  if(a.token_expired)return '<span class=muted title="this account\'s access token expired (Claude tokens are short-lived). Re-login to refresh it.">token expired — re-login: '+(a.n==='orch'?(eng==='claude'?'cmax orchestrator':'cdx orch'):(eng==='claude'?'cmax '+a.n:'cdx login '+a.n))+' → /login</span>';
  if(eng==='opencode'){
    var tel=a.telemetry||{},t=tel.totals||{};
    if(!tel.available)return '<span class=muted title="'+esc(tel.error||'No opencode.db exists for this profile yet')+'">local telemetry unavailable — start an OpenCode session on this profile</span>';
    var last=t.last_activity?new Date(t.last_activity*1000).toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}):'—';
    var models=(tel.models||[]).map(function(m){return m.model+': '+fmtTok(m.out||0)+' out / '+fmtTok(m.in||0)+' in'}).join('\n');
    return '<div title="'+esc(models)+'"><div style="color:var(--fg);font-weight:650">7D · '+fmtTok(t.out||0)+' output · '+fmtTok(t.in||0)+' input · '+fmtTok(t.reasoning||0)+' reasoning</div>'+
      '<div class=muted>'+fmtTok((t.cr||0)+(t.cw||0))+' cache · '+fmtTok(t.completions||0)+'/'+fmtTok(t.requests||0)+' completed/requests · '+fmtTok(t.unfinished||0)+' unfinished</div>'+
      '<div class=muted>'+fmtTok(t.errors||0)+' failures · '+fmtTok(t.rate_limits||0)+' rate limits · '+fmtTok(t.sessions||0)+' sessions · '+fmtTok(t.native_subagents||0)+' native subagents</div>'+
      '<div class=muted>'+fmtTok(t.tool_calls||0)+' tools ('+fmtTok(t.tool_errors||0)+' errors) · '+fmtTok(t.files||0)+' files · <span style="color:var(--ok)">+'+fmtTok(t.adds||0)+'</span>/<span style="color:var(--accent)">−'+fmtTok(t.dels||0)+'</span> lines · last '+esc(last)+'</div>'+
      '<div class=muted title="OpenCode publishes no account quota ceiling, so no percentage is invented">local opencode.db · exact activity, no published quota cap</div></div>';
  }
  if(eng==='kimi'){
    var kt=a.telemetry||{},k=kt.totals||{};
    if(!kt.available)return '<span class=muted>local telemetry unavailable — start a Kimi session on this profile</span>';
    return '<div><div style="color:var(--fg);font-weight:650">7D · '+fmtTok(k.out||0)+' output · '+fmtTok(k.in||0)+' input</div>'+
      '<div class=muted>'+fmtTok((k.cr||0)+(k.cw||0))+' cache · '+fmtTok(k.completions||0)+'/'+fmtTok(k.requests||0)+' completed/requests</div>'+
      '<div class=muted>'+fmtTok(k.errors||0)+' failures · '+fmtTok(k.rate_limits||0)+' rate limits · '+fmtTok(k.sessions||0)+' sessions · '+fmtTok(k.native_subagents||0)+' native subagents</div>'+
      '<div class=muted>'+fmtTok(k.tool_calls||0)+' tools ('+fmtTok(k.tool_errors||0)+' errors) · '+fmtTok(k.files||0)+' files</div>'+
      '<div class=muted title="Kimi exposes no documented account quota ceiling">local Kimi wire logs · exact activity, no published quota cap</div></div>';
  }
  if(eng==='grok'){
    var gt=a.telemetry||{},g=gt.totals||{};
    if(!gt.available)return '<span class=muted>local telemetry unavailable — start a Grok session on this profile</span>';
    return '<div><div style="color:var(--fg);font-weight:650">7D · '+fmtTok(g.out||0)+' output · '+fmtTok(g.in||0)+' input · '+fmtTok(g.reasoning||0)+' reasoning</div>'+
      '<div class=muted>'+fmtTok((g.cr||0)+(g.cw||0))+' cache · '+fmtTok(g.completions||0)+'/'+fmtTok(g.requests||0)+' completed/requests</div>'+
      '<div class=muted>'+fmtTok(g.errors||0)+' failures · '+fmtTok(g.rate_limits||0)+' rate limits · '+fmtTok(g.sessions||0)+' sessions · '+fmtTok(g.native_subagents||0)+' native subagents</div>'+
      '<div class=muted>'+fmtTok(g.tool_calls||0)+' tools ('+fmtTok(g.tool_errors||0)+' errors) · '+fmtTok(g.files||0)+' files</div>'+
      '<div class=muted title="xAI exposes no documented account quota ceiling in Grok Build">local Grok session JSONL · exact activity, no published quota cap</div></div>';
  }
  var u=a.usage||{},five=u.five_hour||{},sev=u.seven_day||{},now=nowS(),h='';
  var st=u.stale?' <span class=muted title="last known reading — live fetch briefly unavailable">·last known</span>':'';
  function line(lbl,w,cls,extra){
    if(w.used_percent==null)return '';
    var p=Math.round(w.used_percent),reset='';
    if(w.resets_at&&w.resets_at>now)reset=' <span class=muted>resets '+resetLabel(w.resets_at)+'</span>';
    return '<div class=usline><span class=uslbl>'+lbl+'</span><span class="bar '+cls+'"><i class="'+barCls(p)+'" style="width:'+Math.min(100,p)+'%"></i></span><span>'+p+'%'+reset+(extra||'')+'</span></div>';
  }
  h+=line('5H',five,'',st);h+=line('7D',sev,'sm');
  return h||'<span class=muted title="no per-account reading is available right now — shown as unknown rather than a number from another account">usage unknown — open '+(a.n==='orch'?(eng==='claude'?'cmax orchestrator':'cdx orch'):(eng==='claude'?'cmax '+a.n:'cdxmax '+a.n))+' once</span>';
}
function acctRow(eng,a,now){
  var cls=a.authenticated?(a.paused?'paused':(a.cooldown_until>now?'cool':'on')):'off';
  var chips='';var pbtn='';
  if(a.authenticated){
    if(a.plan)chips+='<span class="chip plan">'+esc(a.plan)+'</span> ';
    if(a.auth_method)chips+='<span class="chip">'+esc(a.auth_method)+'</span> ';
    if(a.worker_eligible===false)chips+='<span class="chip cool" title="This API-key profile works in the native Kimi CLI. Managed K3/K2.7 Neomax workers require Kimi Code OAuth.">native CLI only · OAuth required for K3 pool</span> ';
    chips+='<span class="chip live">'+a.live+' live</span> ';
    if(a.agents>0)chips+='<span class="chip agents" title="'+(a.workers||0)+' worker(s) + '+(a.mains||0)+' active main session(s) + '+(a.subagents||0)+' sub-agent(s) drawing on this account now">'+(a.workers||0)+'w + '+(a.mains||0)+'m + '+(a.subagents||0)+'s = '+a.agents+(a.agents===1?' agent':' agents')+'</span> ';
    if(a.cooldown_until>now)chips+='<span class="chip cool">cooldown '+fmtAge(a.cooldown_until-now)+' → '+clockTime(a.cooldown_until)+'</span>';
    if(a.paused)chips='<span class="chip paused" title="PAUSED — no tasks will be dispatched to this account until you unpause it. It stays logged in; toggle anytime, takes effect immediately (no orchestrator restart).">⏸ PAUSED — no dispatch</span> '+chips;
    // toggle in/out of dispatch — live, keeps the account logged in
    pbtn=' <button class="sm pausebtn'+(a.paused?' on':'')+'" data-p-eng="'+eng+'" data-p-n="'+a.n+'" data-p-on="'+(a.paused?0:1)+'" title="'+(a.paused?'Resume dispatching tasks to this account':'Stop dispatching tasks to this account (keeps it logged in; live, no restart)')+'">'+(a.paused?'Unpause':'Pause')+'</button>';
  }
  var isOrch=(a.role==='orchestrator'||a.n==='orch');
  // Codex removed its 5h limit — it rotates on WEEKLY only, so don't claim a 5h trigger there.
  if(a.rotate_advised){var rtrig=(eng==='codex')?'≥99% weekly (Codex has no 5h window)':'≥99% 5h or ≥99% weekly';
    chips='<span class="chip cool" title="this account is at '+rtrig+' — any heavy session on it (orchestrator, sub-agent fleets, workflows) should rotate: run `neomax handoff` in that session (handoff --check to test)">ROTATE ADVISED</span> '+chips;}
  var nm=(isOrch?'orchestrator':'acct '+a.n)+(a.display_name?' — '+esc(a.display_name):'');
  if(isOrch&&a.authenticated)chips='<span class="chip orch" title="ISOLATED ORCHESTRATOR account — when launched with --orchestrator it is reserved (excluded from the worker pool) and ONLY orchestrates; the gold border tracks this slot. Monitor its usage here; rotate it in place with `neomax rotate-auth orch --from <fresh-acct>` so the orchestrator keeps going on fresh quota (the AUTH ROTATIONS banner shows when it happens).">★ ISOLATED ORCHESTRATOR</span> '+chips;
  var who='<div class=who><div class=nm title="'+esc(a.dir||'')+'">'+nm+'</div><div class=em title="'+esc(a.email||'')+'">'+(a.email?esc(a.email):'<span class=muted>—</span>')+'</div></div>';
  var right;
  if(a.authenticated){right='<div class=use>'+usage(a,eng)+'<div style="margin-top:6px">'+chips+pbtn+'</div></div>';}
  else{right='<div class=use><span class=muted>not signed in</span></div><button class=sm data-c-eng="'+eng+'" data-c-n="'+a.n+'">Connect</button>';}
  var cardcls='acct'+(isOrch&&a.authenticated?' orch'+(a.rotate_advised?' rotate':''):'')+(a.paused?' paused':'');
  return '<div class="'+cardcls+'"><span class="dot '+cls+'"></span>'+who+right+'</div>';
}
function fleet(eng,accts){
  var by={},mx=((eng==='opencode'||eng==='kimi'||eng==='grok')?1:3);accts.forEach(function(a){by[a.n]=a;if(typeof a.n==='number'&&a.n>mx)mx=a.n});
  var out=[];for(var i=1;i<=mx;i++){out.push(by[i]||{n:i,engine:eng,authenticated:false,live:0,cooldown_until:0,usage:null})}
  // the dedicated orchestrator account is keyed 'orch' (a string), NOT a numeric slot — the
  // numeric loop above can't emit it. Append it so its gold ISOLATED ORCHESTRATOR card renders.
  if(by['orch'])out.push(by['orch']);
  return out;
}
function badges(r){
  var b='';if(r.ultra)b+='<span class="badge ultra">ultra</span>';if(r.opus)b+='<span class="badge opus">opus 4.8</span>';
  if(r.effort)b+='<span class=badge>'+r.effort+'</span>';if(r.attempt>1)b+='<span class=badge>try '+r.attempt+'</span>';
  if(r.tag)b+='<span class="badge tag" title="fan-out plan">'+esc(r.tag)+'</span>';
  if(r.goal)b+='<span class="badge tag" title="goal: '+esc(r.goal)+'">goal</span>';
  return b;
}
function btnsFor(r){
  var b='';
  if(['stalled','timeout','aborted','interrupted'].indexOf(r.status)>=0)b+='<button class=sm data-act=resume data-id="'+r.id+'">resume</button> ';
  else if(['error','limit'].indexOf(r.status)>=0)b+='<button class=sm data-act=retry data-id="'+r.id+'">retry</button> ';
  else if(r.status==='orphaned')b+='<button class=sm data-act=kill data-id="'+r.id+'">kill</button> ';
  var terminal=['done','error','limit','stalled','timeout','aborted','interrupted'].indexOf(r.status)>=0;
  if(terminal&&!r.acknowledged)b+='<button class=sm data-act=ack data-id="'+r.id+'">ack</button> ';
  if(r.status==='done')b+='<button class=sm data-act=clean data-id="'+r.id+'">clean</button> ';
  if(r.branch&&r.worktree_state!=='cleaned')b+='<button class=sm data-diff="'+r.id+'">diff</button> ';
  if(r.pr_url)b+='<a href="'+esc(r.pr_url)+'" target=_blank><button class=sm data-pr="'+esc(r.pr_url)+'">PR ↗</button></a>';
  return b;
}
function childRow(c){
  var st=c.status==='running'?'<span class=spin></span>':(c.status==='error'?'<span style="color:var(--bad)">✗</span>':'<span style="color:var(--ok)">✓</span>');
  var tool=c.last_tool?(' <span class=muted>· '+esc(c.last_tool)+'</span>'):'';
  var tok=c.tokens?(' <span class=muted>· '+fmtTok(c.tokens)+' tok</span>'):'';
  return '<div class=child>'+st+' <span class=clabel>'+esc(c.label||c.id||'agent')+'</span>'+tool+tok+'</div>';
}
function taskCard(r,now){
  var age=fmtAge(now-(r.started||now));
  var meta=[];if(r.project)meta.push(projBadge(r.project));meta.push('<span class=eng>'+r.engine+' · acct '+r.acct_no+(r.account?(' <span class=muted>('+esc(r.account)+')</span>'):'')+'</span>');
  if(r.model)meta.push('<span class=eng>'+esc(shortModel(r.model))+'</span>');
  if(r.session)meta.push('<span class="eng mono" title="session '+esc(r.session)+'">#'+esc(String(r.session).slice(0,8))+'</span>');
  var nact=(r.child_list||[]).filter(function(c){return c.status==='running'}).length;
  var isStep=(r.child_list||[]).length&&(r.child_list||[]).every(function(c){return c.kind==='step'});
  if(r.children)meta.push('<span class=eng>'+(nact?(nact+' active / '):'')+r.children+(isStep?' steps':' sub-agents')+'</span>');
  var tok=(r.child_list||[]).reduce(function(s,c){return s+(c.tokens||0)},0);
  if(tok)meta.push('<span class=eng>'+fmtTok(tok)+' sub-agent tok</span>');
  if(r.repo)meta.push('<span class=eng>'+esc(r.repo)+'</span>');
  if(r.branch)meta.push('<span class="eng mono">'+esc(r.branch)+'</span>');
  if(r.worktree)meta.push('<span class="eng mono" title="'+esc(r.worktree)+'">wt:…/'+esc(String(r.worktree).split('/').slice(-2).join('/'))+'</span>');
  if(r.worktree_state)meta.push('<span class=badge title="worktree state">'+esc(r.worktree_state)+'</span>');
  var tch=(r.files_touched&&r.files_touched.length)?'<div class=tch>files: '+esc(r.files_touched.slice(0,5).join(', '))+(r.files_touched.length>5?' …':'')+'</div>':'';
  var kids=(r.child_list&&r.child_list.length)?'<div class=children>'+r.child_list.map(childRow).join('')+'</div>':'';
  return '<div class="taskcard '+(r.status==='orphaned'?'orphaned':'')+'">'+
    '<div class=top><div class=pr>'+(r.status==='running'?'<span class=spin></span> ':'')+esc(r.prompt)+'</div><div class=age>'+age+'</div></div>'+
    '<div class=sub>'+meta.join('')+badges(r)+'</div>'+tch+kids+
    '<div style="margin-top:7px">'+btnsFor(r)+' <button class=sm data-log="'+r.id+'">log</button></div></div>';
}
function runRow(r,now){
  var ack=r.acknowledged?'':' <span class="pill inboxpill">inbox</span>';
  var sub=r.children?(' <span class=eng>+'+r.children+'</span>'):'';
  var ln2=[shortModel(r.model),r.effort].filter(Boolean).join(' · ');
  return '<tr data-proj="'+esc(r.project||'')+'"><td><span class="s-'+r.status+'">'+r.status+'</span>'+ack+'</td>'+
    '<td class=eng>'+fmtAge(now-(r.started||now))+'</td>'+
    '<td class=eng>'+(r.project?projBadge(r.project)+' ':'')+r.engine.slice(0,3)+'/'+r.acct_no+sub+(ln2?'<div class=tch>'+esc(ln2)+'</div>':'')+'</td>'+
    '<td>'+esc(r.prompt)+(r.branch?'<div class="tch mono">'+esc(r.branch)+(r.worktree_state?' · '+esc(r.worktree_state):'')+'</div>':'')+'</td>'+
    '<td style="text-align:right;white-space:nowrap">'+btnsFor(r)+'</td></tr>';
}
function tile(v,l,cls){return '<div class="tile '+(cls||'')+'"><div class=v>'+v+'</div><div class=l>'+l+'</div></div>'}
function engHint(eng,accts){
  var up=0,lv=0,ag=0,out=0,req=0;
  accts.forEach(function(a){if(a.authenticated)up++;lv+=a.live||0;ag+=a.agents||0;var t=((a.telemetry||{}).totals||{});out+=t.out||0;req+=t.requests||0});
  return (eng==='claude'?'Fable 5':(eng==='codex'?'gpt-5.6':(eng==='opencode'?'OX Alpha Free':(eng==='kimi'?'K3 / K2.7':'Grok Build'))))+' · '+up+'/'+accts.length+' up · '+lv+' live · '+ag+(ag===1?' agent':' agents')+((eng==='opencode'||eng==='kimi'||eng==='grok')?' · 7d '+fmtTok(out)+' out / '+fmtTok(req)+' requests':'');
}
function render(){
  if(!DATA)return;var s=DATA,now=nowS();
  document.getElementById('clock').textContent=new Date().toLocaleTimeString();
  var sm=s.summary||{};
  var sc=sm.fleet_scope||[];
  document.getElementById('scopeNote').textContent=
    (sc.length&&sc.length<5)?(' · scope: '+sc.join('+')+'-only'):'';
  var agentsCell=(sm.agents_total||0)+(sm.subagents?'<span style="font-size:12px;color:var(--dim)"> ('+sm.subagents+' sub)</span>':'');
  document.getElementById('stats').innerHTML=
    tile(sm.running||0,'tasks running',(sm.running?'accent':''))+
    tile(agentsCell,'total agents','')+
    tile(sm.live_total||0,'live sessions','')+
    tile((sm.accounts_up||0)+'<span style="font-size:13px;color:var(--dim2)">/'+(sm.accounts_total||0)+'</span>','accounts up','')+
    tile(sm.cooling||0,'cooling down',(sm.cooling?'warn':''))+
    tile(sm.inbox||0,'inbox',(sm.inbox?'warn':''));
  ['claude','codex','opencode','kimi','grok'].forEach(function(eng){
    var real=(s.engines[eng]||{accounts:[]}).accounts;
    var hint=document.getElementById(eng+'Hint');
    if(hint&&real.length)hint.textContent=engHint(eng,real);
    var accts=fleet(eng,real);
    document.getElementById(eng+'Accts').innerHTML=accts.map(function(a){return acctRow(eng,a,now)}).join('');
  });
  var ib=document.getElementById('inbox');
  if(s.inbox){ib.style.display='block';ib.innerHTML='COMPLETION INBOX — '+s.inbox+' finished run(s) awaiting acknowledgement. Ack or clean them below so nothing is missed.';}
  else ib.style.display='none';
  var lean=document.getElementById('leanHint');
  if(sm.claude_weekly_exhausted){lean.style.display='block';lean.innerHTML='CLAUDE WEEKLY POOL EXHAUSTED — every Claude account ≥99% weekly. Selection refuses; in-flight tasks auto-continue on Codex (cross-engine). Reopens at the weekly resets.';}
  else if(sm.codex_weekly_exhausted){lean.style.display='block';lean.innerHTML='CODEX WEEKLY POOL EXHAUSTED — every Codex account ≥99% weekly. In-flight tasks auto-continue on Claude.';}
  else if(sm.claude_weekly_soft){lean.style.display='block';lean.innerHTML='CLAUDE WEEKLY SOFT BAND — every Claude account ≥95% weekly (freshest: '+sm.claude_weekly_min+'%). Still running: selection uses the freshest until 99%, rotating through the band.';}
  else if(sm.codex_weekly_soft){lean.style.display='block';lean.innerHTML='CODEX WEEKLY SOFT BAND — every Codex account ≥95% weekly (freshest: '+sm.codex_weekly_min+'%). Still running until 99%.';}
  else lean.style.display='none';
  var dup=document.getElementById('dupHint'),dups=sm.duplicate_accounts||[];
  if(dups.length){
    dup.style.display='block';
    dup.innerHTML='DUPLICATE LOGIN — '+dups.map(function(em){
      var ns=[];
      ['claude','codex'].forEach(function(eng){
        ((s.engines[eng]||{}).accounts||[]).forEach(function(a){
          if(a.email!==em)return;
          (a.duplicate_of||[]).concat([a.n]).forEach(function(n){if(ns.indexOf(n)<0)ns.push(n)});
        });
      });
      ns.sort(function(x,y){return x-y});
      return esc(em)+' is signed into '+(ns.length||2)+' profiles'+(ns.length?' (accounts '+ns.join(' & ')+')':'');
    }).join(' · ')+'; they share one usage pool. Re-login one: cmax N → /login.';
  }
  else dup.style.display='none';
  var ar=(s.summary&&s.summary.auth_rotations||[]);
  var arEl=document.getElementById('authrot');
  if(arEl){
    if(ar.length){arEl.style.display='block';
      arEl.innerHTML='AUTH ROTATIONS (last 6h) — '+ar.map(function(x){
        var t=new Date((x.ts||0)*1000).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
        return t+': '+esc(x.dest||'')+' → '+esc(x.to_email||x.src||'')+(x.reason&&x.reason!=='manual'?' ('+esc(x.reason)+')':'');
      }).join(' · ');}
    else arEl.style.display='none';
  }
  // Active orchestrators panel — concurrent Neomax provider sessions (separate terminals)
  var orchs=(s.orchestrators||[]).filter(function(o){return o.live});
  var opEl=document.getElementById('orchpanel');
  if(opEl){
    if(orchs.length>=1){
      opEl.style.display='block';
      document.getElementById('orchHint').textContent=(orchs.length>1
        ?orchs.length+' running in parallel — each owns its own runs; coordinate merges to a shared main'
        :'1 active — owns its own runs');
      var runsByOrch={};(s.runs||[]).forEach(function(r){if(r.status==='running'||r.status==='orphaned')runsByOrch[r.orch_session]=(runsByOrch[r.orch_session]||0)+1});
      document.getElementById('orchList').innerHTML=orchs.map(function(o){
        var idle=Math.max(0,(s.now||0)-(o.last_seen||0));
        var proj=o.project?esc(o.project):'<span class=muted>multi / no project</span>';
        var pref=o.branch_prefix?('<span class="chip" title="branch namespace">'+esc(o.branch_prefix)+'/</span>'):'';
        var rn=runsByOrch[o.session]||0;
        return '<div class=acct><span class="dot on"></span>'+
          '<div class=who><div class=nm>'+esc(o.engine)+' · acct '+esc(String(o.account))+(o.reserved?' <span class="chip orch">reserved</span>':'')+'</div>'+
          '<div class=em title="'+esc(o.cwd||'')+'">'+proj+'</div></div>'+
          '<div class=use><div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">'+pref+
          (o.model?'<span class="chip mono" title="selected orchestrator model">'+esc(o.model)+'</span>':'')+
          '<span class=chip>'+rn+' run'+(rn===1?'':'s')+' in flight</span>'+
          '<span class=chip title="last active">idle '+fmtAge(idle)+'</span>'+
          '<span class="chip mono" title="orchestrator session id">'+esc(String(o.session||'').slice(0,22))+'</span>'+
          '</div></div></div>';
      }).join('');
    } else opEl.style.display='none';
  }
  // Backlog panel — the durable task list (neomax task): the orchestrator's source of truth.
  var tasks=(s.tasks||[]);
  var OPEN={todo:1,doing:1,blocked:1};
  var openTasks=tasks.filter(function(t){return OPEN[t.status]});
  var bpEl=document.getElementById('backlogpanel');
  if(bpEl){
    if(tasks.length){
      bpEl.style.display='block';
      var doneN=tasks.length-openTasks.length;
      document.getElementById('backlogHint').textContent=openTasks.length+' open · '+doneN+' resolved';
      var ord={doing:0,blocked:1,todo:2,done:3,merged:4,dropped:5};
      var shown=tasks.slice().filter(function(t){return OPEN[t.status]||t.status==='done'||t.status==='merged'});
      shown.sort(function(a,b){return (ord[a.status]==null?9:ord[a.status])-(ord[b.status]==null?9:ord[b.status])||(b.updated||0)-(a.updated||0)});
      var SC={doing:'on',blocked:'warn',todo:'',done:'muted',merged:'muted',dropped:'muted'};
      document.getElementById('backlogList').innerHTML=shown.slice(0,40).map(function(t){
        var dim=(t.status==='done'||t.status==='merged'||t.status==='dropped');
        var runs=(t.runs&&t.runs.length)?('<span class="chip mono" title="linked run">'+esc(t.runs[0])+'</span>'):'';
        var pj=t.project?('<span class=chip>'+esc(t.project)+'</span>'):'';
        return '<div class=acct'+(dim?' style="opacity:.5"':'')+'>'+
          '<div class=who><div class=nm>'+esc(t.id)+' · '+esc(t.title||'')+'</div>'+
          '<div class=em>'+esc((t.notes&&t.notes.length)?t.notes[t.notes.length-1]:'')+'</div></div>'+
          '<div class=use><div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">'+pj+runs+
          '<span class="chip" title="status">'+esc((t.status||'todo').toUpperCase())+'</span>'+
          '</div></div></div>';
      }).join('');
    } else bpEl.style.display='none';
  }
  var rot=(s.summary&&s.summary.rotate_advised||[]).filter(function(x){return (x.live||0)>0||(x.agents||0)>0});
  var rotEl=document.getElementById('rotbanner');
  if(rotEl){
    if(rot.length){rotEl.style.display='block';
      var anyClaude=rot.some(function(x){return x.engine!=='codex'});
      var trig=anyClaude?'≥99% 5h / ≥99% weekly':'≥99% weekly';
      rotEl.innerHTML='ROTATION ADVISED — '+rot.map(function(x){return x.engine+' acct '+x.n+' ('+(x.live||0)+' live, '+(x.agents||0)+' agents)'}).join(' · ')+' is '+trig+' with active sessions. Run `neomax handoff` in those sessions to rotate onto a fresher account.';}
    else rotEl.style.display='none';
  }
  var runs=s.runs||[],active=runs.filter(function(r){return r.status==='running'||r.status==='orphaned'});
  var amb=s.ambient||[];
  var ambWorking=amb.reduce(function(t,x){return t+(x.agents||[]).filter(function(a){return a.working}).length},0);
  var rcParts=[];
  if(active.length)rcParts.push(active.length+' dispatched');
  if(amb.length)rcParts.push(amb.length+' interactive session'+(amb.length>1?'s':''));
  if(ambWorking)rcParts.push(ambWorking+' sub-agent'+(ambWorking>1?'s':'')+' working');
  document.getElementById('runningCount').textContent=rcParts.join(' · ')||'idle';
  var ambHtml=amb.length?
    '<div class=modesec style="margin-top:10px">Interactive sessions <span class=muted style="font-weight:400">(your own sessions across all five engines — not orchestrator-dispatched)</span></div>'+
    amb.map(function(x){
      var where=(x.cwd||'').split('/').slice(-2).join('/');
      var nWork=(x.agents||[]).filter(function(a){return a.working}).length,nDone=x.agents.length-nWork;
      var subBreak=x.agents.length?' <span class=muted style="font-weight:400">('+(nWork?nWork+' working':'')+(nWork&&nDone?', ':'')+(nDone?nDone+' done':'')+')</span>':'';
      var subs=x.agents.length?' · <b>'+x.agents.length+' sub-agent'+(x.agents.length>1?'s':'')+'</b>'+subBreak:'';
      var age=(x.age_s!=null)?' · <span class=muted>active '+(x.age_s<5?'now':x.age_s+'s ago')+'</span>':'';
      // tokens split input / output / cache. Main/orchestrator agent's own (x.tok) + a sub-agent rollup.
      var mainTok=fmtTokBreak(x.tok,'this session’s own tokens (the orchestrator/main agent) — input / output / cache');
      var roll={in:0,out:0,cache:0};(x.agents||[]).forEach(function(a){var t=a.tok||{};roll.in+=t.in||0;roll.out+=t.out||0;roll.cache+=t.cache||0});
      var subTokChip=(roll.in||roll.out||roll.cache)?' · <span class=eng title="across this session’s sub-agents — input / output / cache">+'+fmtTokParts(roll)+' sub-agent</span>':'';
      var who=(x.acct_no==='solo')?esc(x.engine||'claude')+' <span class="chip" title="cmax solo session — single account, in-session sub-agents, no delegation">SOLO</span>':esc(x.engine||'claude')+' acct '+x.acct_no;
      var modelTag=x.model?' · <span class="eng mono">'+esc(shortModel(x.model))+'</span>':'';
      return '<div style="border:1px solid var(--line);padding:10px 12px;margin-bottom:8px">'+
        (x.project?projBadge(x.project)+' ':'')+'<b>'+who+'</b> · session '+esc(String(x.session||'').slice(0,8))+
        (where?' · <span class=muted>'+esc(where)+'</span>':'')+
        (x.branch?' · <code style="font-size:11px">'+esc(x.branch)+'</code>':'')+
        modelTag+' · working'+subs+mainTok+subTokChip+age+
        (x.label?'<div class=muted style="margin:4px 0 0 2px;font-size:12px">→ '+esc(x.label)+'</div>':'')+
        x.agents.map(function(a){
          var wftag=a.wf?'<code style="font-size:10px" title="spawned by a Workflow (ultracode) run">'+esc(String(a.wf).slice(0,11))+'</code> ':'';
          var atok=fmtTokBreak(a.tok,'this sub-agent — input / output / cache');
          var amodel=a.model?' <span class="eng mono">'+esc(shortModel(a.model))+'</span>':'';
          var badge=a.working?'<span class=eng title="writing now">▸ working</span> ':'<span class=muted title="finished its turn — workflow still in progress">✓ done</span> ';
          var ageTag=(a.age_s!=null&&!a.working)?' <span class=muted style="font-size:11px">'+(a.age_s<60?a.age_s+'s':Math.round(a.age_s/60)+'m')+' ago</span>':'';
          return '<div class=muted style="margin:4px 0 0 12px;font-size:12px">'+badge+wftag+esc(a.label||'(agent)')+amodel+atok+ageTag+'</div>'}).join('')+
        '</div>';
    }).join(''):'';
  document.getElementById('active').innerHTML=
    (active.length?active.map(function(r){return taskCard(r,now)}).join(''):
      (amb.length?'':'<div class=muted>no tasks in flight — the orchestrator will fill lanes as work is dispatched</div>'))+ambHtml;
  document.getElementById('ledgerCount').textContent=runs.length+' total';
  document.getElementById('runs').innerHTML=runs.length?
    '<table><tr><th>status</th><th>age</th><th>eng/acct</th><th>task</th><th></th></tr>'+runs.map(function(r){return runRow(r,now)}).join('')+'</table>':
    '<div class=muted>no runs recorded yet</div>';
  annotatePr();
  buildProjFilter(s);applyProjFilter();
}
function histRow(r){
  var when=new Date((r.ended||r.started||0)*1000).toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
  var sub=r.children?(' <span class=eng>+'+r.children+' sub</span>'):'';
  var bdg=(r.ultra?'<span class="badge ultra">ultra</span>':'')+(r.opus?'<span class="badge opus">opus</span>':'')+(r.tag?'<span class="badge tag">plan</span>':'')+(r.goal?'<span class="badge tag">goal</span>':'');
  var pr=(r.branch?'<button class=sm data-diff="'+r.id+'">diff</button> ':'')+(r.pr_url?'<a href="'+esc(r.pr_url)+'" target=_blank><button class=sm data-pr="'+esc(r.pr_url)+'">PR ↗</button></a>':'');
  return '<tr class=histrow data-proj="'+esc(r.project||'')+'"><td><span class="s-'+r.status+'">'+esc(r.status||'')+'</span>'+sub+'</td>'+
    '<td class=eng>'+esc(when)+'</td><td class=eng>'+(r.project?projBadge(r.project)+' ':'')+(r.engine||'').slice(0,3)+'/'+(r.acct_no||'?')+'</td>'+
    '<td>'+esc(r.prompt||'')+bdg+(r.branch?'<div class="tch mono">'+esc(r.branch)+'</div>':'')+'</td>'+
    '<td style="text-align:right;white-space:nowrap">'+pr+' <button class=sm data-log="'+r.id+'">log</button></td></tr>';
}
function renderHistory(){
  var box=document.getElementById('history');
  if(!HIST){box.innerHTML='<div class=muted>loading…</div>';return}
  box.innerHTML=HIST.length?
    '<table><tr><th>status</th><th>when</th><th>eng/acct</th><th>task</th><th></th></tr>'+HIST.map(histRow).join('')+'</table>':
    '<div class=muted>no run history yet — runs are archived permanently as they finish</div>';
  annotatePr();applyProjFilter();
}
function showTab(name){
  TAB=name;
  document.querySelectorAll('#tabs .tab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-tab')===name)});
  document.getElementById('ledgerCard').style.display=name==='ledger'?'':'none';
  document.getElementById('historyCard').style.display=name==='history'?'':'none';
  document.getElementById('usageCard').style.display=name==='usage'?'':'none';
  if(name==='history')loadHistory();
  if(name==='usage')loadUsage();
}
var USAGE=null,USAGE_DAYS=30;
function loadUsage(){fetch('/api/usage?days='+USAGE_DAYS).then(function(r){return r.json()}).then(function(j){USAGE=j;renderUsage()}).catch(function(){})}
function usageTable(nameLbl,rows,nameFn){
  if(!rows||!rows.length)return '<div class=muted style="margin:6px 0 14px">no usage recorded for this range</div>';
  var num='text-align:right;white-space:nowrap';
  return '<table style="margin-bottom:14px"><tr><th>'+nameLbl+'</th>'+
    ['input','output','reasoning','cache write','cache read','done / requests','errors / 429','cost'].map(function(h){return '<th style="text-align:right">'+h+'</th>'}).join('')+'</tr>'+
    rows.map(function(r){return '<tr><td>'+nameFn(r)+'</td>'+
      ['in','out','reasoning','cw','cr'].map(function(k){return '<td style="'+num+'">'+fmtTok(r[k]||0)+'</td>'}).join('')+
      '<td style="'+num+'">'+fmtTok(r.completions||0)+' / '+fmtTok(r.requests==null?(r.completions||0):r.requests)+'</td>'+
      '<td style="'+num+'">'+fmtTok(r.errors||0)+' / '+fmtTok(r.rate_limits||0)+'</td>'+
      '<td style="'+num+';font-weight:700;color:var(--accent)">'+fmtUsd(r.cost)+'</td></tr>'}).join('')+'</table>';
}
function openCodeTelemetryHtml(profiles){
  if(!profiles||!profiles.length)return '';
  return '<div class=modesec>OpenCode SQLite detail <span class=muted style="font-weight:400">(selected range · exact local records; no quota ceiling inferred)</span></div>'+profiles.map(function(p){
    if(!p.available)return '<div class=moderow><b>'+esc(p.account||'OpenCode')+'</b> <span class=muted>'+esc(p.error||'no local database yet')+'</span></div>';
    var t=p.totals||{},last=t.last_activity?new Date(t.last_activity*1000).toLocaleString():'—';
    var tools=(p.tool_usage||[]).length?'<table style="margin-bottom:14px"><tr><th>tool</th><th>status</th><th style="text-align:right">calls</th></tr>'+(p.tool_usage||[]).map(function(x){return '<tr><td>'+esc(x.tool||'?')+'</td><td>'+esc(x.status||'?')+'</td><td style="text-align:right">'+fmtTok(x.calls||0)+'</td></tr>'}).join('')+'</table>':'<div class=muted>no tool calls</div>';
    var lastErr=p.last_error?'<div class="inbox" style="display:block;background:transparent;color:var(--accent);border-color:var(--accent);margin:8px 0">Last OpenCode failure · '+esc(p.last_error.name||'Error')+(p.last_error.status?' HTTP '+esc(String(p.last_error.status)):'')+' · '+esc(p.last_error.message||'')+' · '+new Date((p.last_error.at||0)*1000).toLocaleString()+'</div>':'';
    return '<div class=moderow><div class=mtitle>'+esc(p.account||'OpenCode')+' · '+fmtTok(t.out||0)+' output · '+fmtTok(t.in||0)+' input · '+fmtTok(t.reasoning||0)+' reasoning · '+fmtTok((t.cr||0)+(t.cw||0))+' cache · '+fmtUsd(t.cost)+'</div>'+
      '<div class=tch>'+fmtTok(t.completions||0)+'/'+fmtTok(t.requests||0)+' completed/requests · '+fmtTok(t.unfinished||0)+' unfinished · '+fmtTok(t.errors||0)+' failures · '+fmtTok(t.rate_limits||0)+' rate limits · '+fmtTok(t.sessions||0)+' sessions ('+fmtTok(t.native_subagents||0)+' native subagents) · '+fmtTok(t.tool_calls||0)+' tools · '+fmtTok(t.files||0)+' files · +'+fmtTok(t.adds||0)+'/−'+fmtTok(t.dels||0)+' lines · last '+esc(last)+'</div>'+lastErr+
      '<div class=modesec>Models</div>'+usageTable('model',p.models||[],function(r){return esc(r.model||'?')})+
      '<div class=modesec>Built-in / native agent roles</div>'+usageTable('agent',p.agents||[],function(r){return esc(r.agent||'?')})+
      '<div class=modesec>Tools</div>'+tools+'</div>';
  }).join('');
}
function renderUsage(){
  var tl=document.getElementById('usageTiles'),box=document.getElementById('usageBody');
  if(!USAGE){tl.innerHTML='';box.innerHTML='<div class=muted>loading…</div>';return}
  var g=USAGE.grand||{};
  tl.innerHTML=
    tile(fmtUsd(g.cost),'est. api value','accent')+
    tile(fmtTok(g.out||0),'output tok','')+
    tile(fmtTok(g['in']||0),'input tok','')+
    tile(fmtTok(g.reasoning||0),'reasoning tok','')+
    tile(fmtTok(g.completions||0)+'/'+fmtTok(g.requests||g.completions||0),'done / requests','')+
    tile(fmtTok(g.errors||0)+'/'+fmtTok(g.rate_limits||0),'errors / 429','')+
    tile(fmtTok(g.cw||0),'cache write tok','')+
    tile(fmtTok(g.cr||0),'cache read tok','');
  box.innerHTML=
    '<div class=modesec style="margin-top:4px">By date <span class=muted style="font-weight:400">(newest first)</span></div>'+
    usageTable('date',USAGE.by_date,function(r){return '<b>'+esc(r.date||'?')+'</b>'})+
    '<div class=modesec>By model</div>'+
    usageTable('model',USAGE.by_model,function(r){return esc((r.provider?r.provider+' / ':'')+(r.model||'?'))})+
    '<div class=modesec>By provider</div>'+
    usageTable('provider',USAGE.by_provider,function(r){return esc(r.provider||'?')})+
    '<div class=modesec>By account</div>'+
    usageTable('account',USAGE.by_account,function(r){return esc((r.provider?r.provider+' / ':'')+(r.account||'?'))})+
    '<div class=modesec>By native agent</div>'+
    usageTable('agent',USAGE.by_agent,function(r){return esc((r.account?r.account+' / ':'')+(r.agent||'?'))})+
    '<div class=modesec>Top sessions <span class=muted style="font-weight:400">(API value first, then token volume so free OpenCode sessions still rank)</span></div>'+
    usageTable('session',USAGE.by_session,function(r){return esc((r.provider?r.provider+' / ':'')+String(r.session||'?').slice(0,8))})+
    openCodeTelemetryHtml(USAGE.opencode)+kimiTelemetryHtml(USAGE.kimi)+grokTelemetryHtml(USAGE.grok);
}


  fetch('/api/connect/'+eng+'/'+n,{method:'POST'}).then(function(r){return r.json()}).then(function(j){alert(j.message||'started');setTimeout(load,1500)})}
function act(a,id){fetch('/api/act/'+a+'/'+id,{method:'POST'}).then(function(r){return r.json()}).then(function(j){if(j.message)console.log('[neomax]',j.message);load();if(TAB==='history')loadHistory()})}

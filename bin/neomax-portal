var PRSTATE={};
function annotatePr(){
  document.querySelectorAll('button[data-pr]').forEach(function(btn){
    var u=btn.getAttribute('data-pr');
    if(PRSTATE[u]){if(PRSTATE[u].label)btn.textContent='PR '+PRSTATE[u].label+' ↗';return}
    PRSTATE[u]={};
    fetch('/api/prstate?url='+encodeURIComponent(u)).then(function(r){return r.json()}).then(function(j){
      var lbl=j.merged?'merged':(j.state?String(j.state).toLowerCase()+(j.isDraft?'/draft':''):'');
      PRSTATE[u]={label:lbl};
      document.querySelectorAll('button[data-pr="'+u.replace(/"/g,'')+'"]').forEach(function(b){if(lbl)b.textContent='PR '+lbl+' ↗'});
    }).catch(function(){});
  });
}

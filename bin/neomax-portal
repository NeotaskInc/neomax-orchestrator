#!/usr/bin/env python3
"""neomax-portal — a tiny localhost dashboard for the multi-account orchestrator.

Run on demand:  neomax-portal [PORT]   (default 8787) → open http://127.0.0.1:8787

Dependency-free (python3 stdlib only), so it runs anywhere the repo is cloned.
Shows every Claude, Codex, OpenCode, Kimi, and Grok account: auth, live sessions, provider
usage windows when available, cooldowns, run ledger, and completion inbox. Lets you
authenticate accounts and acknowledge/clean finished runs. All data comes from
`neomax status --json` (one source of truth) — the portal renders, never
duplicates logic.

Binds to 127.0.0.1 only (local-only; never exposed).
"""
import http.server
import json
import os
import re
import socketserver
import subprocess
import sys
import urllib.parse

HOME = os.path.expanduser("~")
SELF = os.path.dirname(os.path.abspath(__file__))
NEOMAX = os.path.join(SELF, "neomax")
CDX = os.path.join(SELF, "cdx")
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8787


def status_json():
    try:
        out = subprocess.run([NEOMAX, "status", "--json"],
                             capture_output=True, text=True, timeout=20).stdout
        return json.loads(out)
    except Exception as e:
        return {"error": str(e), "engines": {}, "runs": [], "inbox": 0, "now": 0}


def history_json(limit=60):
    try:
        out = subprocess.run([NEOMAX, "history", "--json", str(limit)],
                             capture_output=True, text=True, timeout=15).stdout
        return json.loads(out)
    except Exception:
        return []


def modes_json():
    try:
        out = subprocess.run([NEOMAX, "modes", "--json"],
                             capture_output=True, text=True, timeout=15).stdout
        return json.loads(out)
    except Exception:
        return {}


def usage_json(days=30):
    try:
        out = subprocess.run([NEOMAX, "usage", "--json", "--days", str(days)],
                             capture_output=True, text=True, timeout=20).stdout
        return json.loads(out)
    except Exception:
        return {"grand": {}, "by_provider": [], "by_model": [], "by_account": [],
                "by_date": [], "by_session": [], "by_agent": [], "opencode": [],
                "kimi": [], "grok": []}


_PR_CACHE = {}


def pr_state(url):
    """Live PR state via `gh pr view` (state/draft/merged), cached 120s per url so the
    dashboard can label PR buttons without hammering GitHub. {} when gh/url unavailable."""
    import time as _t
    if not url or not re.match(r"^https://github\.com/[\w.-]+/[\w.-]+/pull/\d+$", url):
        return {}
    hit = _PR_CACHE.get(url)
    if hit and _t.time() - hit[0] < 120:
        return hit[1]
    out = {}
    try:
        r = subprocess.run(["gh", "pr", "view", url, "--json", "state,isDraft,mergedAt"],
                           capture_output=True, text=True, timeout=8)
        if r.returncode == 0 and r.stdout.strip():
            d = json.loads(r.stdout)
            out = {"state": d.get("state"), "isDraft": bool(d.get("isDraft")),
                   "merged": bool(d.get("mergedAt"))}
    except Exception:
        pass
    _PR_CACHE[url] = (_t.time(), out)
    return out


def sessions_json(days=3):
    try:
        out = subprocess.run([NEOMAX, "sessions", "--json", "--days", str(days)],
                             capture_output=True, text=True, timeout=30).stdout
        return json.loads(out)
    except Exception:
        return []


def subagents_json(days=3):
    try:
        out = subprocess.run([NEOMAX, "subagents", "--json", "--days", str(days)],
                             capture_output=True, text=True, timeout=60).stdout
        return json.loads(out)
    except Exception:
        return []


def rundiff_json(rid):
    try:
        r = subprocess.run([NEOMAX, "diff", rid, "--json"],
                           capture_output=True, text=True, timeout=30)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout)
        return {"error": (r.stderr or "no diff available").strip()[-300:]}
    except Exception as e:
        return {"error": str(e)}


def run_log(rid):
    """The worker stream-log for a run — live (from the active ledger) or archived
    (history). Returned as text; capped so the browser stays responsive."""
    # try the live log first (running/finished-but-not-cleaned), else the archive
    for args in (["log", rid], ["history", rid, "--log"]):
        try:
            r = subprocess.run([NEOMAX] + args, capture_output=True, text=True, timeout=15)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout[-400000:]
        except Exception:
            pass
    return ""


